<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AhuErp.UI</RootNamespace>
    <AssemblyName>AhuErp.UI</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ApplicationDefinition Condition="'$(ApplicationDefinition)' == ''">App.xaml</ApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="LiveCharts.Wpf" Version="0.9.7" />
    <!-- Phase 21 / Improvement #18: Serilog — статический логгер для UI.
         Пишем в %LOCALAPPDATA%\AhuErp\logs\ahuerp-.log (rolling daily,
         сохраняем 14 файлов) и в Debug-output. Через статический
         Log.Logger используется в App.xaml.cs (unhandled exceptions,
         фоновые таймеры) — без отдельной DI-обёртки, чтобы не плодить
         зависимости в сервисах AhuErp.Core (там логирование идёт
         через IAuditService). -->
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AhuErp.Core\AhuErp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\balashov-coa.png" />
  </ItemGroup>

</Project>
