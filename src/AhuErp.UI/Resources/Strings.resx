<?xml version="1.0" encoding="utf-8"?>
<!--
  AhuErp UI strings, нейтральная (русская) культура.

  Phase 21 / Improvement #18 — .resx-локализация. Файл подцеплен в
  AhuErp.UI.csproj как EmbeddedResource с явным LogicalName
  "AhuErp.UI.Resources.Strings.resources", чтобы Strings.Designer.cs
  обращался к нему через ResourceManager без штампа сборки.

  Для альтернативной культуры добавьте параллельный файл
  Strings.<culture>.resx (например, Strings.en-US.resx) — он будет
  выбран автоматически по CurrentUICulture.

  Ключ должен совпадать с публичным property в Strings.Designer.cs.
-->
<root>
